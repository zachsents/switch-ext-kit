{
  "name": "switch-ext-hello",
  "version": "0.1.0",
  "private": true,
  "description": "What it is, in a line.",
  "license": "MIT",
  "repository": "github:OWNER/switch-ext-hello",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt --write .",
    "fix": "bun run lint && bun run format",
    "captions": "ui-captions src",
    "check": "bun run typecheck && bun run captions && bun run fix"
  },
  "extension": {
    "name": "hello",
    "main": "src/main.ts",
    "heartbeat": 300000,
    "widgets": [
      "notes"
    ]
  }
}
